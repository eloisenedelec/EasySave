<UserControl x:Class="EasySave.Views.AddJobOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:EasySave.UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#415A77"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="Foreground" Value="#1B263B"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#415A77"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#415A77"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BrowseBtn" TargetType="Button">
            <Setter Property="Background" Value="#E0E1DD"/>
            <Setter Property="Foreground" Value="#415A77"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D0D3D8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#415A77"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1B263B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#778DA9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F1F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#FFFFFF"
            CornerRadius="12"
            Padding="32,28"
            MaxWidth="460"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.18" Color="#000000"/>
        </Border.Effect>
        <StackPanel>

            <TextBlock Text="{Binding [addjob_title], Source={x:Static ui:LanguageManager.Instance}}"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#1B263B"
                       Margin="0,0,0,24"/>

            <!-- nom -->
            <TextBlock Text="{Binding [addjob_name], Source={x:Static ui:LanguageManager.Instance}}" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource InputBox}"
                     Margin="0,0,0,16"/>

            <!-- src -->
            <TextBlock Text="{Binding [addjob_source], Source={x:Static ui:LanguageManager.Instance}}" Style="{StaticResource FieldLabel}"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}"
                         Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="{Binding [btn_browse], Source={x:Static ui:LanguageManager.Instance}}"
                        Style="{StaticResource BrowseBtn}"
                        Command="{Binding BrowseSourceCommand}"/>
            </Grid>

            <!-- destination -->
            <TextBlock Text="{Binding [addjob_target], Source={x:Static ui:LanguageManager.Instance}}" Style="{StaticResource FieldLabel}"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}"
                         Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="{Binding [btn_browse], Source={x:Static ui:LanguageManager.Instance}}"
                        Style="{StaticResource BrowseBtn}"
                        Command="{Binding BrowseTargetCommand}"/>
            </Grid>

            <!-- affichage d'erreur -->
            <Border Background="#FFF0F0"
                    BorderBrush="#FFCCCC"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,16"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#C0392B"
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Btns d'actions -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<!-- annuler-->
                <Button Content="{Binding [btn_cancel], Source={x:Static ui:LanguageManager.Instance}}"
                        Style="{StaticResource GhostBtn}"
                        Command="{Binding CancelCommand}"
                        Margin="0,0,8,0"/>
				<!--creer un job-->
                <Button Content="{Binding [addjob_create], Source={x:Static ui:LanguageManager.Instance}}"
                        Style="{StaticResource PrimaryBtn}"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
